---
import data from '../data/portfolio.json';
const { your_name, portfolio_title, portfolio_description } = data.site_metadata;
const { index_page } = data;
const { hero_section } = index_page;

interface Props {
	title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} | ${your_name}` : portfolio_title;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="description" content={portfolio_description}>
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet">
        
                <style is:global>
        
                    body {
        
                        background-color: #FDFCF8; /* Warm Paper */
        
                        color: #1C1924;            /* Purple Ink */
        
                        overflow-x: hidden;
        
                    }
        
                    
        
                    /* Noise adds texture to the "paper" feel */
        
                    .noise-overlay {
        
                        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        
                        pointer-events: none; z-index: 50; opacity: 0.03;
        
                        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        
                    }
        
            
        
                    /* ORB: A mix of Warm Gold and Soft Lavender */
        
                    .gradient-orb {
        
                        position: fixed; top: -10%; left: -10%; width: 60vw; height: 60vw;
        
                        background: radial-gradient(circle, rgba(104, 94, 128, 0.12) 0%, rgba(253, 252, 248, 0) 70%);
        
                        filter: blur(90px); z-index: -1;
        
                        animation: pulse 12s infinite alternate;
        
                    }
        
                    @keyframes pulse {
                        0% { transform: translate(0, 0) scale(1); opacity: 0.12; }
                        100% { transform: translate(10px, -10px) scale(1.1); opacity: 0.08; }
                    }
                    
        
                    /* SCROLLBAR: Matches the paper theme */
        
                    ::-webkit-scrollbar { width: 6px; }
        
                    ::-webkit-scrollbar-track { background: #FDFCF8; }
        
                    ::-webkit-scrollbar-thumb { background: #D1D1D6; border-radius: 3px; }
        
                    
        
                    ::selection {
        
                        background: #7E7498; /* 'accent-light' */
        
                        color: #fff;
        
                    }

                    /* Mobile-specific touch optimizations */
                    .touch-manipulation {
                        touch-action: manipulation;
                    }

                    /* Smooth scrolling for mobile */
                    html {
                        scroll-behavior: smooth;
                        -webkit-text-size-adjust: 100%;
                    }

                    /* Mobile tap highlights */
                    * {
                        -webkit-tap-highlight-color: rgba(104, 94, 128, 0.2);
                    }

                    /* Focus styles for accessibility */
                    a:focus-visible, button:focus-visible {
                        outline: 2px solid #685E80;
                        outline-offset: 2px;
                        border-radius: 4px;
                    }

                    /* Mobile hover states using pointer media query */
                    @media (hover: hover) {
                        .project-card:hover img {
                            transform: scale(1.05);
                        }
                    }

                    /* Touch-friendly active states for mobile */
                    .touch-manipulation:active {
                        transform: scale(0.98);
                        transition: transform 0.1s ease;
                    }
        
                </style>    </head>
    <body class="font-sans antialiased">
        <div class="noise-overlay"></div>
        <div class="gradient-orb"></div>
    
        <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 md:px-12 lg:px-20 py-6 lg:py-12 lg:py-0">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8 lg:gap-12 min-h-screen">
                
                            <header class="lg:col-span-3 lg:h-screen lg:sticky lg:top-0 flex flex-col py-0 z-10">
                                <div class="mb-2 md:mb-4 lg:mb-12 mt-8 lg:mt-24">
                                    <div class="flex items-start justify-between lg:block">
                                        <div class="flex-1">
                                            <h1 class="font-serif text-5xl sm:text-6xl lg:text-6xl leading-[0.85] mb-2 lg:mb-3 text-ink font-normal tracking-tight">
                                                <a href="/">{your_name.split(' ')[0]}<br>
                                                <span class="text-gray-400 italic font-light">{your_name.split(' ')[1]}.</span></a>
                                            </h1>
                                            <p class="lg:hidden text-gray-600 text-sm sm:text-base leading-relaxed font-medium max-w-[200px] sm:max-w-[240px] mt-4">
                                                Wellesley '26.<br>
                                                Bridging Media Arts & Sciences with Psychology.
                                            </p>
                                        </div>
                                        <div class="lg:hidden shrink-0 w-[160px] h-[160px] sm:w-[180px] sm:h-[180px] md:w-[200px] md:h-[200px] relative rounded-full overflow-hidden ml-4">
                                            <img 
                                                src={hero_section.photo.path} 
                                                alt={hero_section.photo.description} 
                                                class="w-full h-full object-cover grayscale-0" 
                                                loading="eager"
                                                decoding="async"
                                            />
                                        </div>
                                    </div>
                                </div>
                        <p class="hidden lg:block text-gray-600 text-sm max-w-[220px] leading-relaxed font-medium mt-12">
                            Wellesley '26.<br>
                            Bridging Media Arts & Sciences with Psychology.
                        </p>
                    <nav class="hidden lg:block mt-12">
                        <ul class="space-y-4 text-sm tracking-widest uppercase text-gray-600 font-bold">
                            <li><a href="/" class={`hover:text-black transition-all flex items-center gap-2 group ${Astro.url.pathname === '/' ? 'text-black' : ''}`}><span class={`h-[1px] transition-all ${Astro.url.pathname === '/' ? 'w-12 bg-black' : 'w-0 bg-transparent group-hover:w-8 group-hover:bg-gray-300'}`}></span> Work</a></li>
                            <li><a href="/about" class={`hover:text-black transition-all flex items-center gap-2 group ${Astro.url.pathname.startsWith('/about') ? 'text-black' : ''}`}><span class={`h-[1px] transition-all ${Astro.url.pathname.startsWith('/about') ? 'w-12 bg-black' : 'w-0 bg-transparent group-hover:w-8 group-hover:bg-gray-300'}`}></span> About</a></li>
                            <li><a href="#contact" class="hover:text-black transition-all flex items-center gap-2 group"><span class="h-[1px] w-0 bg-transparent transition-all group-hover:w-8 group-hover:bg-gray-300"></span> Contact</a></li>
                        </ul>
                    </nav>

                    <!-- Mobile Navigation -->
                    <nav class="lg:hidden fixed bottom-6 left-1/2 transform -translate-x-1/2 z-40">
                        <div class="bg-paper/95 backdrop-blur-xl border border-accent/20 rounded-full px-6 py-3 shadow-2xl shadow-accent/10">
                            <ul class="flex items-center gap-4">
                                <li>
                                    <a href="/" class={`flex items-center gap-2 px-4 py-2 rounded-full transition-all duration-300 touch-manipulation ${Astro.url.pathname === '/' ? 'bg-accent shadow-lg shadow-accent/30' : 'hover:bg-accent/10'}`}>
                                        <svg class={`w-4 h-4 transition-colors duration-300 ${Astro.url.pathname === '/' ? 'text-white' : 'text-ink'}`} fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M9.293 2.293a1 1 0 011.414 0l7 7A1 1 0 0117 11h-1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-3a1 1 0 00-1-1H9a1 1 0 00-1 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-6H3a1 1 0 01-.707-1.707l7-7z" clip-rule="evenodd" />
                                        </svg>
                                        <span class={`text-xs font-medium transition-colors duration-300 ${Astro.url.pathname === '/' ? 'text-white' : 'text-ink'}`}>Work</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="/about" class={`flex items-center gap-2 px-4 py-2 rounded-full transition-all duration-300 touch-manipulation ${Astro.url.pathname.startsWith('/about') ? 'bg-accent shadow-lg shadow-accent/30' : 'hover:bg-accent/10'}`}>
                                        <svg class={`w-4 h-4 transition-colors duration-300 ${Astro.url.pathname.startsWith('/about') ? 'text-white' : 'text-ink'}`} fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd" />
                                        </svg>
                                        <span class={`text-xs font-medium transition-colors duration-300 ${Astro.url.pathname.startsWith('/about') ? 'text-white' : 'text-ink'}`}>About</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="#contact" class="flex items-center gap-2 px-4 py-2 rounded-full transition-all duration-300 touch-manipulation hover:bg-accent/10">
                                        <svg class="w-4 h-4 transition-colors duration-300 text-ink" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                                            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                                        </svg>
                                        <span class="text-xs font-medium transition-colors duration-300 text-ink">Contact</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </nav>
    
                </header>
    
                <main class="lg:col-span-9 py-0 pb-24 lg:pb-0 flex flex-col gap-10 md:gap-6 lg:gap-8 z-0">
                    <slot />
    
                    <section id="contact" class="pt-8 md:pt-12 lg:pt-8 border-t border-gray-300">
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
                            <!-- Column 1: Socials -->
                            <div>
                                <h4 class="text-xs font-medium uppercase tracking-wider text-gray-600 mb-2">Socials</h4>
                                <ul class="space-y-0">
                                    {data.index_page.footer.links.map(link => (
                                        <li><a href={link.href} target="_blank" class="block text-ink hover:opacity-60 transition text-sm touch-manipulation py-0.5">{link.label}</a></li>
                                    ))}
                                </ul>
                            </div>
                            
                            <!-- Column 2: Location -->
                            <div>
                                <h4 class="text-xs font-medium uppercase tracking-wider text-gray-600 mb-2">Location</h4>
                                <p class="block text-ink text-sm mb-1">Wellesley, MA</p>
                                <p class="block text-ink text-sm flex items-center">
                                    <span class="inline-block w-2 h-2 rounded-full bg-green-700 mr-2"></span>
                                    Available Remote
                                </p>
                            </div>

                            <!-- Column 3: Copyright -->
                            <div class="sm:col-span-2 md:col-span-1">
                                <h4 class="text-xs font-medium uppercase tracking-wider text-gray-600 mb-2">Copyright</h4>
                                <p class="text-sm text-ink">&copy; 2026 {your_name}.</p>
                            </div>
                        </div>
                    </section>
            </main>
        </div>
    </div>
</body>
</html>