---
import data from '../data/portfolio.json';
const { your_name, portfolio_title, portfolio_description } = data.site_metadata;

interface Props {
	title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} | ${your_name}` : portfolio_title;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={portfolio_description}>
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Space+Grotesk:wght@300;400;500&display=swap" rel="stylesheet">
    
    <style is:global>
        body {
            background-color: #f9f9f7;
            color: #1a1a1a;
            overflow-x: hidden;
        }
        
        .noise-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; z-index: 50; opacity: 0.03;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        .gradient-orb {
            position: fixed;
            top: -10%; left: -10%; width: 60vw; height: 60vw;
            background: radial-gradient(circle, rgba(230, 200, 180, 0.4) 0%, rgba(255,255,255,0) 70%);
            filter: blur(80px); z-index: -1;
            animation: pulse 12s infinite alternate;
        }

        @keyframes pulse {
            0% { transform: scale(1); opacity: 0.6; }
            100% { transform: scale(1.1); opacity: 0.9; }
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #f9f9f7; }
        ::-webkit-scrollbar-thumb { background: #ccc; border-radius: 3px; }
        
        ::selection { background: #1a1a1a; color: #fff; }
    </style>
</head>
<body class="font-sans antialiased">
    <div class="noise-overlay"></div>
    <div class="gradient-orb"></div>

    <div class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-20 py-12 lg:py-0">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 min-h-screen">
            
            <header class="lg:col-span-3 lg:h-screen lg:sticky lg:top-0 flex flex-col justify-between py-12 lg:py-24 z-10">
                <div>
                    <h1 class="font-serif text-5xl lg:text-6xl leading-tight mb-2 tracking-tight text-black">
                        <a href="/">{your_name.split(' ')[0]}<br><span class="italic text-gray-400">{your_name.split(' ')[1]}.</span></a>
                    </h1>
                    <p class="text-muted text-sm mt-6 max-w-[200px] leading-relaxed font-medium">
                        Wellesley '26. Bridging Media Arts & Sciences with Psychology.
                    </p>
                </div>

                <nav class="hidden lg:block mt-12">
                    <ul class="space-y-4 text-sm tracking-widest uppercase text-gray-400 font-bold">
                        <li><a href="/" class="hover:text-black transition-all flex items-center gap-2 group"><span class="w-8 h-[1px] bg-gray-300 group-hover:w-12 group-hover:bg-black transition-all"></span> Work</a></li>
                        <li><a href="/about" class="hover:text-black transition-all flex items-center gap-2 group"><span class="w-8 h-[1px] bg-gray-300 group-hover:w-12 group-hover:bg-black transition-all"></span> About</a></li>
                        <li><a href="#contact" class="hover:text-black transition-all flex items-center gap-2 group"><span class="w-8 h-[1px] bg-gray-300 group-hover:w-12 group-hover:bg-black transition-all"></span> Contact</a></li>
                    </ul>
                </nav>

                <div class="flex gap-4 text-xs font-bold text-gray-400 mt-8 lg:mt-0 uppercase tracking-wider">
                    {data.index_page.footer.links.map(link => (
                         <a href={link.href} target="_blank" class="hover:text-black transition">{link.label}</a>
                    ))}
                </div>
            </header>

            <main class="lg:col-span-9 py-12 lg:py-24 flex flex-col gap-24 z-10">
                <slot />

                <section id="contact" class="pt-24 border-t border-gray-300">
                    <div class="grid md:grid-cols-2 gap-12">
                        <div>
                            <h2 class="font-serif text-3xl mb-6 text-black">Let's build something scalable.</h2>
                            <a href={`mailto:${data.index_page.footer.links[0].href}`} class="text-xl underline underline-offset-8 decoration-gray-300 hover:decoration-black transition">
                                {data.index_page.footer.links[0].href.replace('mailto:', '')}
                            </a>
                        </div>
                        <div class="grid grid-cols-2 gap-8 text-sm text-gray-500">
                            <div>
                                <h4 class="text-black mb-4 uppercase tracking-widest text-xs font-bold">Socials</h4>
                                <ul class="space-y-2">
                                    {data.index_page.footer.links.map(link => (
                                        <li><a href={link.href} target="_blank" class="hover:text-black transition">{link.label}</a></li>
                                   ))}
                                </ul>
                            </div>
                            <div>
                                <h4 class="text-black mb-4 uppercase tracking-widest text-xs font-bold">Location</h4>
                                <p>Wellesley, MA</p>
                                <p>Available Remote</p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-24 text-xs text-gray-400 uppercase tracking-widest flex justify-between">
                        <span>&copy; 2026 {your_name}.</span>
                        <span>{data.index_page.footer.credit}</span>
                    </div>
                </section>
            </main>
        </div>
    </div>
</body>
</html>