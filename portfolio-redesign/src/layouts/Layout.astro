---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght @400;500;600&family=Italiana&family=JetBrains+Mono:wght @400;500&display=swap" rel="stylesheet">

		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
		<script is:inline src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>
		
		<title>{title}</title>
	</head>
	<body class="antialiased bg-bg text-text selection:bg-gray-200 selection:text-black cursor-none">
		<div class="fixed inset-0 w-full h-full pointer-events-none z-50 opacity-[0.04]" style="background-image: url('https://grainy-gradients.vercel.app/noise.svg');"></div>
		<div id="cursor" class="fixed top-0 left-0 w-3 h-3 bg-text rounded-full pointer-events-none z-[9999] -translate-x-1/2 -translate-y-1/2 mix-blend-difference transition-[width,height] duration-300 ease-out"></div>
		<slot />
        
        <script is:inline>
            const lenis = new Lenis();
            function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
            requestAnimationFrame(raf);

            const cursor = document.getElementById('cursor');
            window.addEventListener('mousemove', (e) => {
                gsap.to(cursor, { x: e.clientX, y: e.clientY, duration: 0.1 });
            });
            document.body.addEventListener('mouseover', (e) => {
                if (e.target.closest('a, button, .hover-trigger')) {
                    cursor.style.width = '50px'; cursor.style.height = '50px'; cursor.style.backgroundColor = 'white';
                } else {
                    cursor.style.width = '12px'; cursor.style.height = '12px'; cursor.style.backgroundColor = '#111116';
                }
            });

            window.addEventListener('load', () => {
                const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
                tl.to('.reveal', { y: "0%", duration: 1.2, stagger: 0.05 })
                  .from('.reveal-img', { scale: 1.2, duration: 1.5 }, "-=1.0");
            });
        </script>
	</body>
</html>

<style is:global>
	.mask { overflow: hidden; display: block; }
	.reveal { transform: translateY(100%); }
</style>