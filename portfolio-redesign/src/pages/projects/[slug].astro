---
import MainLayout from '../../layouts/MainLayout.astro';
import data from '../../data/portfolio.json';

export async function getStaticPaths() {
  const sortedProjects = data.individual_projects.sort((a, b) => {
      const orderA = typeof a.order === 'number' ? a.order : 99;
      const orderB = typeof b.order === 'number' ? b.order : 99;
      return orderA - orderB;
  });
  return sortedProjects.map((project, index) => ({
    params: { slug: project.slug },
    props: { 
        project,
        prevProject: index > 0 ? sortedProjects[index - 1] : null,
        nextProject: index < sortedProjects.length - 1 ? sortedProjects[index + 1] : null
    },
  }));
}

const { project, prevProject, nextProject } = Astro.props;

// Helper function to highlight keywords
const highlightKeywords = (text, keywords) => {
    let highlightedText = text;
    // Sort keywords by length in descending order to prevent partial matches of longer phrases
    keywords.sort((a, b) => b.length - a.length).forEach(keyword => {
        // Use a regex that matches the whole word/phrase to avoid partial word highlights
        const regex = new RegExp(`\\b(${keyword})\\b`, 'gi'); 
        highlightedText = highlightedText.replace(regex, `<span class="bg-purple-100 text-purple-900 px-1.5 py-0.5 rounded-md font-medium">$1</span>`);
    });
    return highlightedText;
};

const executiveSummaryKeywords = [
    "challenging to navigate", "errors in tracking their degree and major",
    "plan and track their major and distribution requirements", "clear, centralized view",
    "reduce confusion", "reducing stress", "intuitive product",
    "simplicity, memorability, and an intuitive flow", "consolidates all of a student’s degree information in one place",
    "fulfilled its intended purpose and is desired by the student body"
];

const problemSpaceDefinitionKeywords = [
    "difficult to maneuver, organize, and centralize",
    "complicates the Wellesley College student experience by adding cognitive overload and confusion",
    "effectively centralize, organize, and track their four-year/three-year degree plan"
];

const postIterationNotesKeywords = [
    "changed over the iteration cycle",
    "eliminated some features",
    "enhance and fine tune key features",
    "conducting two rounds of usability testing"
];

const usabilityDataKeywords = [
    "confused about various parts of the planner",
    "trouble finding their major",
    "spelling mistakes",
    "errors in course distributions",
    "fixed them for our second round",
    "visible hesitance",
    "mistake entering their start year",
    "progress reset",
    "complexity of the tasks",
    "rated the tool a 4.69/5",
    "recommend this planner"
];

const alongResearchGoalKeywords = [
    "Large Language Model (LLM) -based conversational interface",
    "task initiation and time calibration",
    "college students",
    "empirical insights",
    "design implications",
    "future AI time-management tools"
];

const alongMotivationKeywords = [
    "college setting",
    "self-regulation and time management",
    "time blindness",
    "executive dysfunction",
    "LLM-based conversational tools",
    "reduce cognitive load"
];

const alongUserTestingKeywords = [
    "tested our probe with college students",
    "gauge helpfulness of LLM",
    "design implications for similar LLM-powered time/task management tools"
];

const alongTechProbeKeywords = [
    "LLM-interfacing technology probe",
    "micro-step breakdown",
    "chatbot assistant"
];
---

<MainLayout title={project.title}>
    <article class="w-full max-w-5xl mx-auto px-0 md:px-6 lg:px-0 relative" style="min-width: 0; z-index: 1;">
        
        <header class="mb-6 md:mb-8 border-b border-gray-300 pb-4 md:pb-6 px-4 md:px-0 pt-8 lg:pt-14">
            <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl mb-4 md:mb-6 leading-tight">{project.title}</h1>
            <p class="text-lg sm:text-xl text-gray-600 font-serif italic mb-6 md:mb-8">{project.tagline}</p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 text-sm">
                {project.meta.map(m => (
                    <div class="min-w-0">
                        <span class="block text-xs uppercase tracking-widest text-gray-400 font-bold mb-1">{m.label}</span>
                        <span class="block whitespace-pre-line break-words">{m.value}</span>
                    </div>
                ))}
            </div>
        </header>

        {project.layoutType !== 'art' && (
            <div class="space-y-12 mb-20 px-4 md:px-0 w-full" style="overflow-x: hidden; min-width: 0;">
                {project.heroMedia.map(media => {
                    if (media.type === 'interactive-slides') {
                        return (
                            <div class="border border-gray-200 rounded-none overflow-hidden bg-gray-50" id="portfolio-viewer">
                                <div class="flex flex-col md:flex-row h-auto md:h-[600px]">
                                    {/* Thumbnails Sidebar */}
                                    <div class="w-full md:w-64 bg-white border-b md:border-b-0 md:border-r border-gray-200 overflow-y-auto custom-scrollbar">
                                        {media.slides.map((slide, index) => (
                                            <button 
                                                class="w-full text-left px-6 py-4 border-b border-gray-100 hover:bg-gray-50 transition-colors focus:outline-none focus:bg-gray-50 group"
                                                data-slide-index={index}
                                                data-slide-number={slide.number}
                                                onclick={`document.getElementById('slide-frame').src = '${media.baseUrl}&slide=${slide.number}'; document.querySelectorAll('[data-slide-index]').forEach(el => el.classList.remove('bg-gray-100', 'border-l-4', 'border-black')); this.classList.add('bg-gray-100', 'border-l-4', 'border-black');`}
                                            >
                                                <span class="block text-xs text-gray-400 mb-1">{String(index + 1).padStart(2, '0')}</span>
                                                <span class="block text-sm font-medium text-gray-900 group-hover:text-black">{slide.label}</span>
                                            </button>
                                        ))}
                                    </div>
                                    
                                    {/* Slide Content */}
                                    <div class="flex-1 bg-gray-100 relative">
                                        <div class="w-full aspect-video md:h-full md:aspect-auto">
                                            <iframe 
                                                id="slide-frame"
                                                src={`${media.baseUrl}&slide=${media.slides[0].number}`}
                                                class="absolute inset-0 w-full h-full" 
                                                frameborder="0" 
                                                allowfullscreen="true" 
                                                mozallowfullscreen="true" 
                                                webkitallowfullscreen="true">
                                            </iframe>
                                        </div>
                                    </div>
                                </div>
                                
                                {/* Initial State Setup Script */}
                                <script define:vars={{ initialIndex: 0 }}>
                                    document.addEventListener('DOMContentLoaded', () => {
                                        const firstBtn = document.querySelector(`[data-slide-index="${initialIndex}"]`);
                                        if (firstBtn) {
                                            firstBtn.classList.add('bg-gray-100', 'border-l-4', 'border-black');
                                        }
                                    });
                                </script>
                            </div>
                        );
                    }


                    return (
                    <div class="w-full max-w-full rounded-none overflow-hidden bg-gray-100 shadow-sm relative group">
                        {media.link && (
                            <a 
                                href={media.link} 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 inline-flex items-center gap-1 bg-accent text-white px-4 py-2 rounded-full text-xs uppercase tracking-widest font-bold hover:bg-ink transition-colors shadow-sm hover:shadow-md"
                            >
                                Visit Live Site 
                                <svg class="w-3 h-3 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7h-10M17 7v10" />
                                </svg>
                            </a>
                        )}
                        
                        {media.type === 'video' ? (
                            <div class="aspect-video w-full max-w-full relative">
                                <iframe 
                                    src={media.src} 
                                    title={media.alt}
                                    class="absolute inset-0 w-full h-full max-w-full" 
                                    frameborder="0" 
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                    allowfullscreen>
                                </iframe>
                            </div>
                        ) : (
                            <img src={media.src} alt={media.alt} class="w-full h-auto max-w-full" />
                        )}
                    </div>
                )})}
            </div>
        )}

        <div class="grid md:grid-cols-3 gap-6 md:gap-12 px-4 md:px-0" style="min-width: 0;">
            <div class={`${project.layoutType === 'art' ? 'md:col-span-3' : 'md:col-span-2'} space-y-8 md:space-y-12`} style="min-width: 0;">
                {project.sections.map(section => {
                    // Special Layout for Art: Creative Vision + Mediums
                    if (project.layoutType === 'art' && section.title === 'Creative Vision') {
                        return (
                            <div class="grid md:grid-cols-3 gap-12 mt-24 border-t border-gray-200 pt-12">
                                <div class="md:col-span-2">
                                    <h2 class="font-serif text-2xl mb-4" id="creative-vision">{section.title}</h2>
                                    <div class="space-y-4 text-gray-700 leading-relaxed">
                                        {section.body.map(p => <p set:html={p}></p>)}
                                    </div>
                                </div>
                                <div class="md:col-span-1">
                                    <div class="sticky top-24 space-y-8 p-6 bg-white border border-gray-100 shadow-sm rounded-none">
                                        <h4 class="text-xs uppercase tracking-widest font-bold mb-3">Mediums</h4>
                                        <div class="flex flex-wrap gap-2">
                                            {project.sidebar.technologies.map(tech => (
                                                <span class="px-2 py-1 bg-gray-100 text-xs text-gray-600 rounded-none">{tech}</span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        );
                    }

                    const sectionId = section.title ? section.title.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '') : '';

                                        if (section.kind === 'pdf-viewer') {

                                            const media = section.media; // Use section.media

                                            const sectionId = section.title ? section.title.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '') : '';

                                            const totalPages = media.totalPages || 24;

                                            const allPages = Array.from({ length: totalPages }, (_, i) => i + 1);

                    

                                            return (

                                                <div class="scroll-mt-24" id={sectionId}>

                                                    {section.title && <h2 class="font-serif text-2xl mb-4 text-ink">{section.title}</h2>}

                                                    <div class="border border-gray-200 rounded-none overflow-hidden bg-gray-50" id="pdf-viewer">

                                                        <div class="flex flex-col">

                                                            {/* Carousel Wrapper with Custom Navigation Buttons */}

                                                            <div class="relative group">

                                                                {/* Previous Button */}

                                                                <button 

                                                                    class="absolute left-2 md:left-4 top-1/2 -translate-y-1/2 z-10 p-2 md:p-3 rounded-full bg-white/80 hover:bg-white text-gray-800 shadow-lg backdrop-blur-sm transition-all opacity-50 md:opacity-0 group-hover:opacity-100 focus:opacity-100 hover:scale-110 active:scale-95 touch-manipulation"

                                                                    onclick="document.getElementById('pdf-carousel').scrollBy({ left: -document.getElementById('pdf-carousel').offsetWidth, behavior: 'smooth' })"

                                                                    aria-label="Previous Slide"

                                                                >

                                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">

                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />

                                                                    </svg>

                                                                </button>

                    

                                                                {/* Next Button */}

                                                                <button 

                                                                    class="absolute right-2 md:right-4 top-1/2 -translate-y-1/2 z-10 p-2 md:p-3 rounded-full bg-white/80 hover:bg-white text-gray-800 shadow-lg backdrop-blur-sm transition-all opacity-50 md:opacity-0 group-hover:opacity-100 focus:opacity-100 hover:scale-110 active:scale-95 touch-manipulation"

                                                                    onclick="document.getElementById('pdf-carousel').scrollBy({ left: document.getElementById('pdf-carousel').offsetWidth, behavior: 'smooth' })"

                                                                    aria-label="Next Slide"

                                                                >

                                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">

                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />

                                                                    </svg>

                                                                </button>

                    

                                                                {/* Horizontal Carousel (Swipeable - All Pages) */}

                                                                <div id="pdf-carousel" class="w-full aspect-video flex overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar" style="scrollbar-width: none; -ms-overflow-style: none;">

                                                                    {allPages.map((pageNumber) => (

                                                                        <div id={`slide-page-${pageNumber}`} class="w-full flex-shrink-0 snap-center relative bg-white">

                                                                            <iframe 

                                                                                src={`${media.src}#page=${pageNumber}&toolbar=0&navpanes=0&scrollbar=0&view=Fit`}

                                                                                class="absolute inset-0 w-full h-full pointer-events-none" 

                                                                                frameborder="0"

                                                                                loading="lazy">

                                                                            </iframe>

                                                                        </div>

                                                                    ))}

                                                                </div>

                                                            </div>

                    

                                                            {/* Horizontal Thumbnails Strip (Bookmarks Only) */}

                                                            <div class="w-full bg-white border-t border-gray-200 overflow-x-auto custom-scrollbar flex snap-x snap-mandatory">

                                                                {media.slides.map((slide, index) => (

                                                                    <button 

                                                                        class={`flex-shrink-0 w-28 sm:w-48 md:w-64 text-left px-3 sm:px-6 py-3 sm:py-4 border-r border-gray-100 hover:bg-gray-50 transition-colors focus:outline-none focus:bg-gray-50 group relative snap-start touch-manipulation ${index === 0 ? 'bg-gray-100 border-t-4 border-black' : 'border-t-4 border-transparent'}`}

                                                                        onclick={`document.getElementById('slide-page-${slide.number}').scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' }); document.querySelectorAll('#pdf-viewer button').forEach(el => { el.classList.remove('bg-gray-100', 'border-black'); el.classList.add('border-transparent'); }); this.classList.remove('border-transparent'); this.classList.add('bg-gray-100', 'border-black');`}

                                                                    >

                                                                        <span class="block text-[10px] sm:text-xs text-gray-400 mb-1">{String(index + 1).padStart(2, '0')}</span>

                                                                        <span class="block text-xs sm:text-sm font-medium text-gray-900 group-hover:text-black truncate">{slide.label}</span>

                                                                    </button>

                                                                ))}

                                                            </div>

                                                        </div>

                                                    </div>

                                                </div>

                                            );

                                        }

                    

                                                            if (section.kind === 'status-links') {

                    

                                                                const sectionId = section.title ? section.title.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '') : '';

                    

                                                                return (

                    

                                                                    <div class="scroll-mt-24 mb-10 flex items-center gap-4 flex-wrap" id={sectionId}>

                    

                                                                        {section.statusText && (

                    

                                                                            <span class="inline-flex items-center bg-accent text-white px-4 py-2 rounded-full text-xs uppercase tracking-widest font-bold shadow-sm">

                    

                                                                                {section.statusText}

                    

                                                                            </span>

                    

                                                                        )}

                    

                                                                                                                                        {section.liveSiteLink && (

                    

                                                                                                                                            <a 

                    

                                                                                                                                                href={section.liveSiteLink} 

                    

                                                                                                                                                target="_blank" 

                    

                                                                                                                                                rel="noopener noreferrer" 

                    

                                                                                                                                                class="inline-flex items-center px-6 py-2 rounded-full border-2 border-accent text-accent text-xs uppercase tracking-widest font-bold hover:bg-accent hover:text-white transition-all duration-300 group shadow-sm hover:shadow-md"

                    

                                                                                                                                            >

                    

                                                                                                                                                Visit Live Site 

                    

                                                                                                                                                <svg class="w-4 h-4 ml-2 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">

                    

                                                                                                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>

                    

                                                                                                                                                </svg>

                    

                                                                                                                                            </a>

                    

                                                                                                                                        )}

                                                </div>

                                            );

                                        }

                                        // Standard Section Rendering
                    return (
                    <div class="scroll-mt-24" id={sectionId} style="min-width: 0;">
                        {section.title && section.kind !== 'documentation-block' && <h2 class="font-serif text-2xl mb-4 text-ink">{section.title}</h2>}
                        
                        {section.kind === 'paragraphs' && (
                            <div class="space-y-4 text-gray-700 leading-relaxed">
                                {project.slug === 'along' && section.title === 'Research Goal & Contribution' && section.body.map(p => <p set:html={highlightKeywords(p, alongResearchGoalKeywords)}></p>)}
                                {project.slug === 'along' && section.title === 'Motivation' && section.body.map(p => <p set:html={highlightKeywords(p, alongMotivationKeywords)}></p>)}
                                {project.slug === 'along' && section.title !== 'Research Goal & Contribution' && section.title !== 'Motivation' && section.body.map(p => <p set:html={p}></p>)}

                                {project.slug === 'wellesley-degree-tracker' && section.body.map(p => {
                                    let content = p;
                                    let keywords = [];
                                    if (section.title === 'Executive Summary') keywords = executiveSummaryKeywords;
                                    else if (section.title === 'Problem Space Definition') keywords = problemSpaceDefinitionKeywords;
                                    else if (section.title === 'Usability Testing') keywords = postIterationNotesKeywords;
                                    else if (section.title === 'Usability Data') keywords = usabilityDataKeywords;
                                    
                                    if (keywords.length > 0) {
                                        content = highlightKeywords(p, keywords);
                                    }
                                    return <p set:html={content}></p>;
                                })}
                                {(project.slug !== 'wellesley-degree-tracker' && project.slug !== 'along') && section.body.map(p => <p set:html={p}></p>)}
                            </div>
                        )}

                        {section.kind === 'bullets' && (
                            <ul class="space-y-4">
                                {section.items.map(item => {
                                    if (typeof item === 'string') {
                                        return (
                                            <li class="ml-4 list-disc list-outside text-gray-700 text-sm leading-relaxed marker:text-accent">
                                                {item}
                                            </li>
                                        );
                                    }
                                    let itemText = item.text;
                                    if (project.slug === 'along' && section.title === 'What we did…') {
                                        if (item.heading === 'User Testing') {
                                            itemText = highlightKeywords(item.text, alongUserTestingKeywords);
                                        } else if (item.heading === 'Technology Probe') {
                                            itemText = highlightKeywords(item.text, alongTechProbeKeywords);
                                        }
                                    }
                                    return (
                                    <li>
                                        <span class="block font-bold text-sm mb-1 text-ink">{item.heading}</span>
                                        {Array.isArray(itemText) ? ( // itemText can be an array here from highlights
                                            <ul class="ml-4 list-disc list-outside space-y-1 text-gray-600 text-sm leading-relaxed marker:text-accent">
                                                {itemText.map(subItem => (
                                                    <li set:html={subItem}></li>
                                                ))}
                                            </ul>
                                        ) : (
                                            <span class="text-gray-600 text-sm leading-relaxed" set:html={itemText}></span>
                                        )}
                                    </li>
                                )})}
                            </ul>
                        )}

                        {section.kind === 'gallery' && (
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 w-full">
                                {section.items.map(img => (
                                    <div class="space-y-2 cursor-pointer group touch-manipulation min-w-0" onclick={`openLightbox('${img.src}', '${img.alt}')`}>
                                        <img src={img.src} alt={img.alt} class="w-full h-auto max-w-full rounded-none shadow-sm group-hover:opacity-90 transition duration-300" style="object-fit: cover;" />
                                        {img.caption && <p class="text-xs text-gray-500 italic">{img.caption}</p>}
                                    </div>
                                ))}
                            </div>
                        )}

                        {section.kind === 'video' && (
                            <div class="aspect-video w-full max-w-full relative bg-gray-100 rounded-none overflow-hidden shadow-sm">
                                {section.src.endsWith('.mp4') || section.src.endsWith('.webm') ? (
                                    <video 
                                        src={section.src} 
                                        class="absolute inset-0 w-full h-full object-contain max-w-full" 
                                        controls 
                                        muted 
                                        loop 
                                        playsinline>
                                    </video>
                                ) : (
                                    <iframe 
                                        src={section.src} 
                                        title={section.title || "Video"}
                                        class="absolute inset-0 w-full h-full max-w-full" 
                                        frameborder="0" 
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                        allowfullscreen>
                                    </iframe>
                                )}
                            </div>
                        )}

                        {section.kind === 'documentation-block' && (
                            <div class="bg-accent-light/20 border border-accent/20 rounded-none p-8 my-12 text-center">
                                <h3 class="font-serif text-2xl mb-4 text-ink">{section.title}</h3>
                                <div class="text-gray-700 mb-8 max-w-2xl mx-auto leading-relaxed">
                                    {section.body.map(p => <p>{p}</p>)}
                                </div>
                                <a 
                                    href={section.link.url} 
                                    target="_blank" 
                                    rel="noopener noreferrer" 
                                    class="inline-block bg-accent hover:bg-ink text-white font-medium px-8 py-4 rounded-none transition-all hover:shadow-lg hover:-translate-y-0.5"
                                >
                                    {section.link.text}
                                </a>
                            </div>
                        )}

                        {section.kind === 'approach-grid' && (
                            <div class="mt-4">
                                {section.body && (
                                    <div class="space-y-4 text-gray-700 leading-relaxed mb-6 md:mb-8">
                                        {section.body.map(p => <p set:html={p}></p>)}
                                    </div>
                                )}
                                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
                                    {section.items.map(item => (
                                        <div>
                                            <h4 class="font-bold text-base md:text-lg mb-2 text-ink">{item.heading}</h4>
                                            <p class="text-gray-600 text-sm leading-relaxed">{item.text}</p>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        {section.kind === 'table' && (
                            <div class="mt-4 mb-8 w-full overflow-x-auto" style="-webkit-overflow-scrolling: touch;">
                                <table class="w-full min-w-full text-xs text-left text-gray-600 border border-gray-200" style="width: 800px;">
                                        <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-200">
                                            <tr>
                                                {section.headers.map(header => (
                                                    <th scope="col" class="px-2 sm:px-3 md:px-4 py-3 font-bold tracking-wider whitespace-nowrap bg-gray-100/50 text-[9px] sm:text-[10px] md:text-xs">
                                                        {header}
                                                    </th>
                                                ))}
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {section.rows.map((row, rowIndex) => (
                                                <tr class={`border-b border-gray-100 hover:bg-gray-50/50 transition-colors ${rowIndex % 2 === 0 ? 'bg-white' : 'bg-gray-50/30'}`}>
                                                    {row.map((cell, cellIndex) => {
                                                        let cellContent = cell;
                                                        let cellClass = `px-2 sm:px-3 md:px-4 py-2 md:py-3 leading-relaxed text-[9px] sm:text-[10px] md:text-xs ${cellIndex === 0 ? 'font-medium text-gray-900' : ''}`;
                                                        
                                                        // Color coding logic - ensuring clean replacement
                                                        if (cell.includes('<b>High</b>')) {
                                                            cellContent = cell.replace('<b>High</b>', '<span class="inline-flex items-center px-1 md:px-2 py-0.5 rounded-full text-[8px] md:text-[10px] font-medium bg-green-100 text-green-800 border border-green-200 mr-1 uppercase tracking-wide">High</span>');
                                                        } else if (cell.includes('<b>Medium</b>')) {
                                                            cellContent = cell.replace('<b>Medium</b>', '<span class="inline-flex items-center px-1 md:px-2 py-0.5 rounded-full text-[8px] md:text-[10px] font-medium bg-yellow-100 text-yellow-800 border border-yellow-200 mr-1 uppercase tracking-wide">Med</span>');
                                                        } else if (cell.includes('<b>Low</b>')) {
                                                            cellContent = cell.replace('<b>Low</b>', '<span class="inline-flex items-center px-1 md:px-2 py-0.5 rounded-full text-[8px] md:text-[10px] font-medium bg-red-100 text-red-800 border border-red-200 mr-1 uppercase tracking-wide">Low</span>');
                                                        } else if (cell.includes('<b>Emotional</b>')) {
                                                            cellContent = cell.replace('<b>Emotional</b>', '<span class="inline-flex items-center px-1 md:px-2 py-0.5 rounded-full text-[8px] md:text-[10px] font-medium bg-purple-100 text-purple-800 border border-purple-200 mr-1 uppercase tracking-wide">Emot</span>');
                                                        } else if (cell.includes('<b>Intellectual</b>')) {
                                                            cellContent = cell.replace('<b>Intellectual</b>', '<span class="inline-flex items-center px-1 md:px-2 py-0.5 rounded-full text-[8px] md:text-[10px] font-medium bg-blue-100 text-blue-800 border border-blue-200 mr-1 uppercase tracking-wide">Intl</span>');
                                                        }
                                                        
                                                        // New logic for '48'
                                                        if (cell === '48') { // Check if the cell content is exactly '48'
                                                            cellClass += ' bg-purple-100 text-purple-900 font-bold'; // Add background, text color, and bold
                                                        }

                                                        return (
                                                            <td class={cellClass} set:html={cellContent}></td>
                                                        );
                                                    })}
                                                </tr>
                                            ))}
                                        </tbody>
                                </table>
                            </div>
                        )}
                    </div>
                )})}
            </div>

            {project.layoutType !== 'art' && (
                <aside class="md:col-span-1">
                    <div class="md:sticky md:top-20 flex flex-col gap-4 z-10">
                        
                        {/* Index / TOC - Collapsible Card */}
                        {project.sections.some(s => s.title && s.title !== "Overview") && (
                            <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
                                <details open class="group">
                                    <summary class="flex items-center justify-between p-3 md:p-4 pr-2 md:pr-3 cursor-pointer select-none bg-gray-50/50 hover:bg-gray-50 transition-colors touch-manipulation">
                                        <span class="text-[10px] uppercase tracking-widest font-bold text-gray-500">On this page</span>
                                        <span class="text-gray-400 group-open:rotate-180 transition-transform duration-200 mr-1">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                            </svg>
                                        </span>
                                    </summary>
                                    <div class="px-3 md:px-4 pb-3 md:pb-4 pt-2 border-t border-gray-100 bg-white">
                                        <ul class="space-y-1">
                                            {project.sections.map(section => {
                                                if (!section.title || section.kind === 'documentation-block') return null;
                                                const sectionId = section.title.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '');
                                                return (
                                                    <li>
                                                        <a href={`#${sectionId}`} class="text-xs text-gray-600 hover:text-indigo-600 transition-colors block py-1.5 pl-2 border-l-2 border-transparent hover:border-indigo-300 touch-manipulation">
                                                            {section.title}
                                                        </a>
                                                    </li>
                                                );
                                            })}
                                        </ul>
                                    </div>
                                </details>
                            </div>
                        )}

                        {/* Project Details - Merged Card */}
                        <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
                            
                            {/* Technologies Section */}
                            <div class="p-4 md:p-5">
                                <h4 class="text-[10px] uppercase tracking-widest font-bold mb-3 text-gray-400">Technologies</h4>
                                <div class="flex flex-wrap gap-1.5">
                                    {project.sidebar.technologies.map(tech => (
                                        <span class="px-2 md:px-2.5 py-1 bg-gray-50 text-[9px] md:text-[10px] font-medium text-gray-600 rounded-full border border-gray-100 hover:border-gray-200 hover:bg-gray-100 transition-colors cursor-default">
                                            {tech}
                                        </span>
                                    ))}
                                </div>
                            </div>

                            {/* External Links / Impact Section */}
                            {project.sidebar.extra.length > 0 && (
                                <div class="border-t border-gray-100 p-4 md:p-5 pt-4">
                                    {project.sidebar.extra.map((ex, index) => (
                                        <div class={index !== 0 ? "mt-4 pt-4 border-t border-gray-100" : ""}>
                                            <h4 class="text-[10px] uppercase tracking-widest font-bold mb-2 text-gray-400 flex items-center gap-1">
                                                {ex.title}
                                            </h4>
                                            <div class="text-sm text-gray-600 leading-relaxed font-medium" set:html={ex.text}></div>
                                        </div>
                                    ))}
                                </div>
                            )}
                        </div>

                    </div>
                </aside>
            )}
        </div>

        {/* Project Navigation */}
        <section class="border-t border-gray-200 mt-16 md:mt-24 pt-8 md:pt-12 pb-12 px-4 md:px-0">
            <div class="flex justify-between items-start md:items-center gap-4">
                {prevProject ? (
                    <a href={`/projects/${prevProject.slug}`} class="group text-left flex-1 touch-manipulation">
                        <span class="block text-xs text-gray-400 uppercase tracking-widest mb-1 group-hover:text-accent transition">&larr; Previous</span>
                        <span class="font-serif text-base md:text-lg group-hover:underline block leading-tight">{prevProject.title}</span>
                    </a>
                ) : <div class="flex-1"></div>}
                
                {nextProject ? (
                    <a href={`/projects/${nextProject.slug}`} class="group text-right flex-1 touch-manipulation">
                        <span class="block text-xs text-gray-400 uppercase tracking-widest mb-1 group-hover:text-accent transition">Next &rarr;</span>
                        <span class="font-serif text-base md:text-lg group-hover:underline block leading-tight">{nextProject.title}</span>
                    </a>
                ) : <div class="flex-1"></div>}
            </div>
        </section>

        {/* Lightbox Modal */}
        <div id="lightbox" class="fixed inset-0 z-[100] bg-white/95 hidden items-center justify-center cursor-zoom-out" onclick="closeLightbox()">
            <img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[90vh] shadow-2xl object-contain" />
            <button class="absolute top-8 right-8 text-4xl font-light text-black hover:opacity-50">&times;</button>
        </div>

        <script is:inline>
            function openLightbox(src, alt) {
                const lightbox = document.getElementById('lightbox');
                const img = document.getElementById('lightbox-img');
                img.src = src;
                img.alt = alt || '';
                lightbox.classList.remove('hidden');
                lightbox.classList.add('flex');
                document.body.style.overflow = 'hidden';
            }

            function closeLightbox() {
                const lightbox = document.getElementById('lightbox');
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
                document.body.style.overflow = '';
            }
            
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeLightbox();
            });
        </script>

    </article>
</MainLayout>