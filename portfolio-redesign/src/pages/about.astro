---
import MainLayout from '../layouts/MainLayout.astro';
import data from '../data/portfolio.json';

const { bio_section, education_section, experience_section, skills_section } = data.about_page;
---

<MainLayout title="About">
    <section class="max-w-4xl pt-24 lg:pt-24">
        
        <div class="grid md:grid-cols-3 gap-12 mb-24">
            <div class="md:col-span-1">
                <img src={bio_section.photo.path} alt={bio_section.photo.description} class="w-full rounded-sm transition duration-500" />
            </div>
            <div class="md:col-span-2 space-y-6">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-6">
                    <h1 class="font-serif text-4xl">{bio_section.title}</h1>
                    <a href={data.index_page.footer.links.find(link => link.label === 'Resume')?.href || '#'} target="_blank" rel="noopener noreferrer" class="inline-block bg-accent text-white px-4 py-2 rounded-full text-xs uppercase tracking-widest font-bold hover:bg-ink transition flex items-center gap-1">
                        View Full Resume <span>↗</span>
                    </a>
                </div>
                {bio_section.paragraphs.map(p => (
                    <p class="text-gray-600 leading-relaxed">{p}</p>
                ))}
            </div>
        </div>

        <hr class="border-gray-300 mb-20" />

        <div class="grid md:grid-cols-4 gap-8 mb-20">
            <h3 class="text-xs uppercase tracking-widest text-gray-500 font-bold md:col-span-1 mt-1">Education</h3>
            <div class="md:col-span-3">
                <div class="mb-8">
                    <h4 class="font-serif text-2xl mb-1">{education_section.details.institution}</h4>
                    <p class="text-sm text-gray-500 mb-2">{education_section.details.degree}</p>
                    <p class="text-xs text-gray-400 uppercase tracking-wider mb-4">{education_section.details.period}</p>
                    <p class="text-sm text-gray-600 bg-gray-100 p-4 rounded-sm inline-block">{education_section.details.fellowship}</p>
                </div>
                <div>
                    <h5 class="text-xs font-bold uppercase mb-2">Relevant Coursework</h5>
                    <div class="flex flex-wrap gap-2">
                        {education_section.coursework.map(course => (
                            <span class="border border-gray-300 px-3 py-1 rounded-full text-xs text-gray-600">{course}</span>
                        ))}
                    </div>
                </div>
            </div>
        </div>

        <div class="grid md:grid-cols-4 gap-8 mb-20">
            <h3 class="text-xs uppercase tracking-widest text-gray-500 font-bold md:col-span-1 mt-1">Research</h3>
            <div class="md:col-span-3 space-y-12">
                {experience_section.research.map(job => (
                    <div class="group relative pl-8 border-l border-gray-200 hover:border-black transition duration-300">
                        <span class="absolute -left-[5px] top-2 w-2.5 h-2.5 bg-gray-200 rounded-full group-hover:bg-black transition duration-300"></span>
                        <h4 class="font-serif text-xl mb-1">{job.company}</h4>
                        <div class="flex justify-between items-center mb-3">
                            <span class="font-bold text-sm">{job.title}</span>
                            <span class="text-xs text-gray-400">{job.period}</span>
                        </div>
                        <p class="text-sm text-gray-600 leading-relaxed">{job.description}</p>
                    </div>
                ))}
            </div>
        </div>

        <div class="grid md:grid-cols-4 gap-8">
            <h3 class="text-xs uppercase tracking-widest text-gray-500 font-bold md:col-span-1 mt-1">Skills</h3>
            <div class="md:col-span-3 grid grid-cols-1 sm:grid-cols-2 gap-8">
                {skills_section.categories.map(cat => (
                    <div>
                        <h5 class="font-serif text-lg mb-3">{cat.name}</h5>
                        <ul class="space-y-1 text-sm text-gray-600">
                            {cat.items.map(skill => (
                                <li>{skill}</li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </div>

    </section>
</MainLayout>