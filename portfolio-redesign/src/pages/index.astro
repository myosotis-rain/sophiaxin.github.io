---
import MainLayout from '../layouts/MainLayout.astro';
import data from '../data/portfolio.json';
import { sortProjects, getThumbnail } from '../utils/helpers.js';

const { hero_section } = data.index_page;
const projects = sortProjects(data.individual_projects);
---

<MainLayout>
    <section class="max-w-6xl pt-0 mb-0">
        
        <div class="flex flex-col-reverse md:flex-row gap-12 md:gap-8 items-start">
            
            <div class="flex-1 mt-24">
                <span class="text-xs uppercase tracking-widest text-gray-600 font-bold block mb-4 font-sans">
                    {hero_section.eyebrow}
                </span>
                
                <h2 class="font-serif text-4xl leading-[1.15] text-ink font-normal text-balance" set:html={hero_section.lede}>
                </h2>
                
            </div>

            <div class="shrink-0 w-[150px] h-[150px] md:w-[200px] md:h-[200px] relative rounded-full overflow-hidden mt-24">
                <img 
                    src={hero_section.photo.path} 
                    alt={hero_section.photo.description} 
                    class="w-full h-full object-cover shadow-sm grayscale-0" 
                />
            </div>

        </div>
    </section>

    <section id="work" class="flex flex-col gap-8 mt-12">
        <div class="flex items-end justify-between border-b border-gray-300/60 pb-4">
            <h2 class="text-xs uppercase tracking-widest text-gray-500 font-bold">Selected Works</h2>
            <span class="text-xs text-gray-500 font-bold">01 / {projects.length.toString().padStart(2, '0')}</span>
        </div>

        {projects.map((project) => {
            const thumbnailSrc = getThumbnail(project.heroMedia);
            const firstMedia = project.heroMedia[0];
            const isVideo = firstMedia.type === 'video';
            
            return (
            <article class="project-card group block">
                
                {/* MEDIA CONTAINER - Now always a link with Thumbnail */}
                <a href={`/projects/${project.slug}`} class="block w-full h-[400px] md:h-[550px] overflow-hidden rounded-md bg-white/50 mb-6 relative shadow-sm border border-white/50 group-hover:shadow-md transition-all duration-500">
                    <img 
                        src={thumbnailSrc} 
                        alt={project.title} 
                        class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
                    />
                    
                    {isVideo && (
                        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                            <div class="w-16 h-16 bg-white/90 rounded-full flex items-center justify-center shadow-lg backdrop-blur-sm group-hover:scale-110 transition-transform duration-300">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8 text-ink ml-1">
                                    <path fill-rule="evenodd" d="M4.5 5.653c0-1.426 1.529-2.33 2.779-1.643l11.54 6.348c1.295.712 1.295 2.573 0 3.285L7.28 19.991c-1.25.687-2.779-.217-2.779-1.643V5.653z" clip-rule="evenodd" />
                                </svg>
                            </div>
                        </div>
                    )}
                </a>

                {/* TEXT CONTENT */}
                <a href={`/projects/${project.slug}`} class="flex flex-col gap-4 border-l-2 border-transparent group-hover:border-accent pl-0 group-hover:pl-4 transition-all duration-300">
                    <div>
                        <h3 class="font-serif text-3xl mb-1 text-ink">{project.title}</h3>
                        <p class="text-gray-500 text-sm font-sans">{project.tagline}</p>
                    </div>
                    <div class="hidden md:block pt-2 mt-4">
                        <span class="font-sans border border-gray-300 rounded-full px-4 py-2 text-xs uppercase tracking-wider group-hover:bg-accent group-hover:text-white transition">View Project &nearr;</span>
                    </div>
                </a>

            </article>
            )
        })}

    </section>
</MainLayout>