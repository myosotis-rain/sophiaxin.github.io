---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import ProjectList from '../components/ProjectList.astro';

// Import Data
import portfolioData from '../data/portfolio.json';

const { site_metadata, index_page, individual_projects } = portfolioData;
const { hero_section, footer } = index_page;
---

<Layout 
  title={site_metadata.portfolio_title}
  description={site_metadata.portfolio_description}
>
    
    <header class="fixed top-0 right-0 p-8 lg:p-12 z-50 flex gap-8 font-mono text-[10px] uppercase tracking-[0.2em] font-medium text-gray-400 mix-blend-difference">
        <a href="/work" class="hover-trigger hover:text-white transition-colors">Work</a>
        <a href="/about" class="hover-trigger hover:text-white transition-colors">About</a>
        <a href="mailto:sx103 @wellesley.edu" class="hover-trigger hover:text-white transition-colors">Contact</a>
    </header>

    <div class="flex flex-col lg:flex-row min-h-screen">
        
        <Sidebar 
            name={hero_section.headline}
            role={hero_section.eyebrow}
            bio={hero_section.lede}
            photo={hero_section.photo.path}
            links={footer.links}
        />

        <ProjectList projects={individual_projects} />

    </div>

</Layout>