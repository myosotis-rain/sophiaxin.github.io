---
import MainLayout from '../layouts/MainLayout.astro';
import data from '../data/portfolio.json';
import { sortProjects } from '../utils/helpers.js';

const { hero_section } = data.index_page;
const projects = sortProjects(data.individual_projects);
---

<MainLayout>
    <section class="max-w-3xl pt-12 lg:pt-0">
        
        <div class="mb-10">
            <img 
                src={hero_section.photo.path} 
                alt={hero_section.photo.description} 
                class="w-24 h-24 object-cover rounded-2xl shadow-sm grayscale-0" 
            />
        </div>

        <div>
            <span class="text-xs uppercase tracking-widest text-gray-400 font-bold block mb-6">{hero_section.eyebrow}</span>
            <p class="text-3xl md:text-4xl lg:text-5xl leading-tight text-black tracking-tight font-medium">
                {hero_section.lede}
            </p>
        </div>
    </section>

    <section id="work" class="flex flex-col gap-20">
        <div class="flex items-end justify-between border-b border-gray-300 pb-4">
            <h2 class="text-xs uppercase tracking-widest text-gray-500 font-bold">Selected Works</h2>
            <span class="text-xs text-gray-500 font-bold">01 / {projects.length.toString().padStart(2, '0')}</span>
        </div>

        {projects.map((project) => {
            const firstMedia = project.heroMedia[0];
            const isVideo = firstMedia.type === 'video';
            
            return (
            <article class="project-card group block">
                
                {/* MEDIA CONTAINER */}
                <div class="w-full h-[400px] md:h-[550px] overflow-hidden rounded-sm bg-gray-200 mb-6 relative shadow-sm">
                    {isVideo ? (
                        <iframe 
                            src={firstMedia.src} 
                            title={project.title}
                            class="w-full h-full absolute inset-0" 
                            frameborder="0" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                            allowfullscreen>
                        </iframe>
                    ) : (
                        <a href={`/projects/${project.slug}`} class="block w-full h-full">
                            <img 
                                src={firstMedia.src} 
                                alt={firstMedia.alt} 
                                class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
                            />
                        </a>
                    )}
                </div>

                {/* TEXT CONTENT */}
                <a href={`/projects/${project.slug}`} class="flex flex-col md:flex-row md:items-start justify-between gap-4 border-l-2 border-transparent group-hover:border-black pl-0 group-hover:pl-4 transition-all duration-300">
                    <div>
                        <h3 class="text-3xl mb-1 text-black font-semibold tracking-tight">{project.title}</h3>
                        <p class="text-gray-500 text-sm">{project.tagline}</p>
                    </div>
                    <div class="hidden md:block pt-2">
                        <span class="border border-gray-300 rounded-full px-4 py-2 text-xs uppercase tracking-wider hover:bg-black hover:text-white transition">View Project &nearr;</span>
                    </div>
                </a>

            </article>
            )
        })}

    </section>
</MainLayout>