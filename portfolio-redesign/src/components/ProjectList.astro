---
interface Props {
  projects: any[];
}

const { projects } = Astro.props;

// Helper to get a valid image source (Local Image OR YouTube Thumbnail)
const getThumbnail = (mediaArray: any[]) => {
    const media = mediaArray[0];
    if (media.type === 'image') return media.src;
    
    // If video is YouTube, extract thumbnail
    if (media.type === 'video' && media.src.includes('youtube')) {
        const videoId = media.src.split('/').pop();
        return `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`;
    }
    
    // Fallback placeholder
    return 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=2564&auto=format&fit=crop';
};
---

<main class="lg:w-[60%] lg:ml-[40%] min-h-screen relative z-10 bg-bg">
    <div class="pt-32 lg:pt-40 pb-40">
        
        <div class="px-8 lg:px-16 border-b border-gray-300 pb-6 mb-16 flex justify-between items-end mask">
            <h2 class="reveal font-sans text-sm font-bold uppercase tracking-widest text-text">Selected Work</h2>
            <span class="reveal font-mono text-[10px] text-gray-400">2023 — 2025</span>
        </div>

        <div class="flex flex-col gap-32">
            {projects.map((project, index) => (
                <a href={`/work/${project.slug}`} class="hover-trigger group flex flex-col gap-6 block">
                    <div class="mask w-full aspect-[16/9] bg-gray-200 overflow-hidden shadow-sm relative pl-8 lg:pl-16">
                        <img 
                            src={getThumbnail(project.heroMedia)} 
                            alt={project.title}
                            class="reveal-img w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105 origin-left"
                        />
                    </div>
                    
                    <div class="px-8 lg:px-16 flex justify-between items-start pt-2 border-t border-transparent group-hover:border-border transition-colors duration-500">
                        <div class="space-y-2">
                            <h3 class="font-serif text-4xl font-normal text-text group-hover:text-blue-700 transition-colors">
                                {project.title}
                            </h3>
                            <div class="flex gap-2">
                                {(project.tags || []).slice(0, 3).map((tag: string) => (
                                    <span class="font-mono text-[10px] text-gray-500 uppercase tracking-wider border border-border px-2 py-0.5 rounded-full bg-white">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        </div>
                        <span class="font-mono text-xs text-gray-400 pt-2">
                            0{index + 1}
                        </span>
                    </div>
                </a>
            ))}
        </div>
    </div>
</main>